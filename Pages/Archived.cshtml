@page
@model Series_Tracker.Pages.ArchivedModel
@{
    ViewData["Title"] = "Archived Series";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Archive</p>
            <h1>Archived series</h1>
        </div>
    </header>

    <section class="card">
        @if (!Model.SeriesItems.Any())
        {
            <p class="empty-state">No archived series yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Series state</th>
                            <th>Progress</th>
                            <th>Notes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SeriesItems)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Author</td>
                                <td><span class="status-pill status-archived">@item.Status</span></td>
                                <td><span class="completion-pill completion-@item.CompletionState.ToString().ToLower()">@item.CompletionState</span></td>
                                <td>@item.CurrentProgress / @item.TotalProgress</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                                <td>
                                    <div class="action-row">
                                        <form method="post" asp-page-handler="Restore">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline">Restore</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
