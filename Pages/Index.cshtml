@page
@model Series_Tracker.Pages.IndexModel
@{
    ViewData["Title"] = "Series Tracker";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Reading list</p>
            <h1>Your series tracker</h1>
        </div>

        <form method="get" class="filter-form">
            <label for="statusFilter">Filter</label>
            <select id="statusFilter" name="StatusFilter" onchange="this.form.submit()">
                <option value="All" selected="@(Model.StatusFilter == "All")">All</option>
                @foreach (var status in Model.StatusOptions)
                {
                    <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                }
            </select>
        </form>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning">@Model.Message</div>
    }

    <section class="card">
        <div class="list-toolbar">
            <h2>Current list</h2>
            <form method="get" class="toolbar-action-form">
                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                <input type="hidden" name="ShowAddDraft" value="true" />
                <button type="submit" class="add-series-button" aria-label="Add a new series" aria-expanded="@Model.ShowAddDraft.ToString().ToLowerInvariant()" title="Add a new series">+</button>
            </form>
        </div>

        @if (Model.ShowAddDraft)
        {
            <form method="post" asp-page-handler="Add" class="inline-add-form">
                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                <input type="hidden" name="ShowAddDraft" value="true" />
                <div class="inline-add-row">
                    <div class="inline-cell wide-cell">
                        <label asp-for="Form.Title">Title</label>
                        <input asp-for="Form.Title" placeholder="Series title" />
                    </div>
                    <div class="inline-cell">
                        <label asp-for="Form.Author">Author</label>
                        <input asp-for="Form.Author" placeholder="Author" />
                    </div>
                    <div class="inline-cell">
                        <label asp-for="Form.CompletionState">Series state</label>
                        <select asp-for="Form.CompletionState" asp-items="Html.GetEnumSelectList<Series_Tracker.Models.SeriesCompletionState>()"></select>
                    </div>
                    <div class="inline-cell">
                        <label asp-for="Form.TotalProgress">Series length</label>
                        <input asp-for="Form.TotalProgress" type="number" min="1" placeholder="Length" />
                    </div>
                    <div class="inline-cell">
                        <label asp-for="Form.CurrentReleasedCount">Released so far</label>
                        <input asp-for="Form.CurrentReleasedCount" type="number" min="0" placeholder="Released" />
                    </div>
                    <div class="inline-cell">
                        <label asp-for="Form.CurrentProgress">Books read</label>
                        <input asp-for="Form.CurrentProgress" type="number" min="0" placeholder="Read so far" />
                    </div>
                    <div class="inline-actions">
                        <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        <a asp-page="/Index" asp-route-statusFilter="@Model.StatusFilter" class="btn btn-sm btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        }

        @if (!Model.SeriesItems.Any())
        {
            <p class="empty-state">No series match the current filter.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SeriesItems)
                        {
                            var rowClass = item.IsProgressComplete() ? "status-row-completed" : $"status-row-{item.Status.ToString().ToLower()}";
                            var availableToReadCount = item.GetAvailableToReadCount();

                            <tr class="status-row @rowClass" tabindex="0" role="link" aria-label="Edit series @item.Title" data-edit-url="@Url.Page("/Series/Edit", new { id = item.Id })">
                                <td>
                                    <a asp-page="/Series/Edit" asp-route-id="@item.Id" class="row-title-link" aria-label="Edit series @item.Title">@item.Title</a>
                                </td>
                                <td>@item.Author</td>
                                <td>
                                    <div>@item.GetDashboardProgressText()</div>
                                    @if (item.Status == Series_Tracker.Models.SeriesStatus.Dropped)
                                    {
                                        <small class="progress-note">Dropped</small>
                                    }
                                    else if (availableToReadCount > 0)
                                    {
                                        <small class="progress-note">@availableToReadCount @(availableToReadCount == 1 ? "book" : "books") to read</small>
                                    }
                                    else if (item.IsUpToDate())
                                    {
                                        <small class="progress-note">Up to date</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
