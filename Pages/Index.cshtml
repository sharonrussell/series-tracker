@page
@model Series_Tracker.Pages.IndexModel
@{
    ViewData["Title"] = "Series Tracker";
}

<div class="page-shell">
    <header class="page-header">
        <div class="page-title">
            <h1>Reading List</h1>
        </div>

        <div class="page-actions">
            <form method="get" class="filter-form">
                <label for="statusFilter">Filter</label>
                <select id="statusFilter" name="StatusFilter" onchange="this.form.submit()">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All</option>
                    <option value="To read" selected="@(Model.StatusFilter == "To read")">To read</option>
                    <option value="Up to date" selected="@(Model.StatusFilter == "Up to date")">Up to date</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Dropped" selected="@(Model.StatusFilter == "Dropped")">Dropped</option>
                </select>
            </form>
            <a asp-page="/Series/Create" class="add-series-button" aria-label="Add a new series" title="Add a new series">+</a>
        </div>
    </header>

    @if (Model.ReadingSummary is { } summary)
    {
        <section class="reading-summary" aria-labelledby="reading-summary-heading">
            <div class="reading-summary-heading">
                <h2 id="reading-summary-heading">Up next</h2>
            </div>
            @if (summary.Suggestion is not { } suggestion)
            {
                <p>Nothing available to read right now</p>
            }
            else if (suggestion is { CanComplete: true, RemainingCount: 1 })
            {
                <p class="reading-summary-message">Wrap up @suggestion.Series.Title with <strong>@suggestion.NextTitle.Title</strong>.</p>
            }
            else if (suggestion.CanComplete)
            {
                <p class="reading-summary-message">Continue @suggestion.Series.Title with <strong>@suggestion.NextTitle.Title</strong>.</p>
            }
            else
            {
                <p class="reading-summary-message"><strong>@suggestion.NextTitle.Title</strong> from @suggestion.Series.Title.</p>
            }
        </section>
    }

    <section class="card reading-list-card">
        @if (!Model.SeriesItems.Any())
        {
            <p class="empty-state">No series match the current filter.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Series</th>
                            <th class="dashboard-progress-heading">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SeriesItems)
                        {
                            var derivedStatus = item.GetDerivedStatus(Model.Today);
                            var rowClass = $"status-row-{derivedStatus.ToString().ToLower()}";

                            <tr class="status-row @rowClass" tabindex="0" role="link" aria-label="Edit series @item.Title" data-edit-url="@Url.Page("/Series/Edit", new { id = item.Id })">
                                <td>
                                    <a asp-page="/Series/Edit" asp-route-id="@item.Id" class="row-title-link" aria-label="Edit series @item.Title">
                                        <span class="series-title">@item.Title</span>
                                        <span class="series-author">@item.Author</span>
                                    </a>
                                </td>
                                <td class="dashboard-progress">
                                    <div class="progress-value">@item.GetDashboardProgressText()</div>
                                    <small class="progress-note">@item.GetDashboardSecondaryText(Model.Today)</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
