@page "{id:int}"
@model Series_Tracker.Pages.Series.EditModel
@{
    ViewData["Title"] = "Edit Series";
}

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Update</p>
            <h1>Edit series</h1>
        </div>
    </header>

    <section class="card add-series-card">
        <form method="post" class="series-form">
            <input type="hidden" asp-for="Form.Id" />

            <div class="field-group">
                <label asp-for="Form.Title">Title</label>
                <input asp-for="Form.Title" />
            </div>

            <div class="field-group">
                <label asp-for="Form.Author">Author</label>
                <input asp-for="Form.Author" />
            </div>

            <div class="field-group">
                <label asp-for="Form.TotalProgress">Series length</label>
                <input asp-for="Form.TotalProgress" type="number" min="1" />
            </div>

            <div class="field-group">
                <label asp-for="Form.CurrentReleasedCount">Released so far</label>
                <input asp-for="Form.CurrentReleasedCount" type="number" min="0" />
            </div>

            <div class="field-group">
                <label asp-for="Form.CurrentProgress">Books read</label>
                <input asp-for="Form.CurrentProgress" type="number" min="0" />
            </div>

            <div class="field-group">
                <label asp-for="Form.Status">Status</label>
                <select asp-for="Form.Status" asp-items="Html.GetEnumSelectList<Series_Tracker.Models.SeriesStatus>()"></select>
            </div>

            <div class="field-group">
                <label asp-for="Form.CompletionState">Series state</label>
                <select asp-for="Form.CompletionState" asp-items="Html.GetEnumSelectList<Series_Tracker.Models.SeriesCompletionState>()"></select>
            </div>

            <div class="field-group wide action-row">
                <button type="submit" class="primary-button">Save changes</button>
                <a asp-page="/Index" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </section>
</div>
